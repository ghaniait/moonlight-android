<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="24dp"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingEnd="24dp"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".preferences.AddComputerManually">

    <TextView
        android:id="@+id/manuallyAddPcText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fontFamily="@font/adventor_bold"
        android:preferKeepClear="true"
        android:text="@string/title_add_pc"
        android:textColor="@color/nb_text"
        android:textSize="26sp" />

    <EditText
        android:id="@+id/hostTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/manuallyAddPcText"
        android:layout_marginTop="24dp"
        android:layout_toStartOf="@+id/addPcButton"
        android:background="@drawable/nb_input_bg"
        android:gravity="center_vertical"
        android:hint="@string/ip_hint"
        android:inputType="textNoSuggestions"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:preferKeepClear="true"
        android:singleLine="true"
        android:textColor="@color/nb_text"
        android:textColorHint="@color/nb_hint"
        android:textSize="16sp">

        <requestFocus />
    </EditText>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addPcButton"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/manuallyAddPcText"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/nb_btn_primary"
        android:fontFamily="@font/adventor_bold"
        android:minWidth="96dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:preferKeepClear="true"
        android:text="@android:string/ok"
        android:textAllCaps="false"
        android:textColor="@color/nb_text"
        android:textSize="15sp" />

</RelativeLayout>
