<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PcView">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <View
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/nb_logo_orb" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adventor_bold"
            android:maxLines="1"
            android:text="@string/app_label_game"
            android:textColor="@color/nb_text"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/nb_btn_glass_circle"
            android:contentDescription="@string/help"
            android:padding="10dp"
            android:preferKeepClear="true"
            android:scaleType="fitCenter"
            android:src="@drawable/nb_ic_help"
            android:tint="@color/nb_text" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/nbDock"
        android:layout_below="@id/topBar"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/nb_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/pcs_loading"
                android:gravity="center_vertical"
                android:text="@string/searching_pc"
                android:textColor="@color/nb_text2"
                android:textSize="15sp" />
        </RelativeLayout>

    </RelativeLayout>

    <include
        layout="@layout/nb_dock_pc"
        android:layout_width="300dp"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="22dp" />

    <!-- The profiles feature is not part of this simplified edition. The view stays in the
         layout (hidden) only because PcView still looks it up by id. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/profile_manager_choose_profile"
        android:visibility="gone"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>
